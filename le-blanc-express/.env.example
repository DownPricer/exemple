PORT=3001

# Destinataire des notifications formulaire (obligatoire pour l'envoi)
CONTACT_TO=

# Adresse affichée au visiteur en cas d'erreur + Reply-To des confirmations client
CONTACT_PUBLIC_EMAIL=contact@sitereadyshd.fr
CONTACT_REPLY_TO=contact@sitereadyshd.fr

# Délai affiché dans l'e-mail de confirmation (aligné sur le site)
CONTACT_RECONTACT_DELAY=48 heures

# Expéditeur (adresse @sitereadyshd.fr recommandée)
MAIL_FROM=SiteReady <noreply@sitereadyshd.fr>

# SMTP (ex. OVH : ssl0.ovh.net, port 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX=5
