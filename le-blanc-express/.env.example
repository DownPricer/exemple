# Port HTTP du serveur Node (derrière nginx)
PORT=3001

# Boîte qui reçoit chaque demande formulaire (peut être Gmail, ex. vous@ gmail.com)
CONTACT_TO=iskive@gmail.com

# Adresse affichée au visiteur en cas d'échec d'envoi
CONTACT_PUBLIC_EMAIL=contact@sitereadyshd.fr

# Reply-To des e-mails de confirmation envoyés aux clients
CONTACT_REPLY_TO=contact@sitereadyshd.fr

# Délai annoncé dans l'e-mail de confirmation client
CONTACT_RECONTACT_DELAY=48 heures

# Expéditeur (doit être autorisé par le serveur SMTP — souvent = SMTP_USER)
MAIL_FROM=SiteReady <contact@sitereadyshd.fr>

# Serveur SMTP (exemple OVH Mail : ssl0.ovh.net, port 587, STARTTLS)
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@sitereadyshd.fr
SMTP_PASS=exemple_mot_de_passe_smtp

# Limite d'envois du formulaire par adresse IP
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX=5

# Admin démos (/admin/demos) — hash bcrypt (jamais le mot de passe en clair)
# Générer avec : node scripts/hash-admin-password.mjs "votre-mot-de-passe"
ADMIN_PASSWORD_HASH=

# Secret de signature des cookies de session admin (chaîne longue aléatoire)
SESSION_SECRET=

# Dossier persistant des maquettes (monté en volume Docker)
DEMOS_DIR=/data/demos
