{
  "name": "siteready-shd",
  "version": "1.0.0",
  "private": true,
  "description": "Site vitrine SiteReady — création de sites pour artisans et commerçants en Ardèche",
  "type": "module",
  "scripts": {
    "build:elegant": "node scripts/build-elegant.mjs",
    "build:static": "node scripts/prerender-static.mjs",
    "build": "npm run build:elegant && npm run build:static",
    "prestart": "npm run build",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "nodemailer": "^6.9.16"
  }
}
