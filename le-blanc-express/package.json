{
  "name": "siteready-shd",
  "version": "1.0.0",
  "private": true,
  "description": "Site vitrine SiteReady — création de sites pour artisans et commerçants en Ardèche",
  "type": "module",
  "scripts": {
    "build:elegant": "node scripts/build-elegant.mjs",
    "build:minimal": "node scripts/build-minimal.mjs",
    "build:anime": "node scripts/build-anime.mjs",
    "build:static": "node scripts/prerender-static.mjs",
    "build:local": "node scripts/build-local-pages.mjs",
    "build": "npm run build:elegant && npm run build:minimal && npm run build:anime && npm run build:local && npm run build:static",
    "prestart": "npm run build",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test:mail": "node scripts/test-mail.mjs",
    "hash-admin-password": "node scripts/hash-admin-password.mjs",
    "test:demos": "node scripts/test-demos.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "multer": "^2.4.0",
    "nodemailer": "^6.9.16",
    "yauzl": "^3.4.0"
  }
}
